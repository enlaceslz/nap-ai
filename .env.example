# ==============================================================================
# NAP (Núcleo de Atendimento ao Provedor) - Modelo de Configuração de Ambiente
# IMPORTANTE: Copie para .env e preencha com credenciais seguras e aleatórias.
# Nunca comite arquivos .env em repositórios de código.
# ==============================================================================

# --- 1. AMBIENTE & CORE SERVER ---
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://provedor.com.br,https://portal.provedor.com.br

# --- 2. SEGURANÇA, CRIPTOGRAFIA & SESSÃO (RBAC) ---
# Gere strings randômicas de 32+ bytes (ex: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
NAP_JWT_SECRET=CHANGE_ME_IN_PRODUCTION
WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION
GENIEACS_UI_JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# --- 3. BANCO DE DADOS POSTGRESQL (Drizzle ORM) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=nap_crm
# Comunicação interna entre containers Docker (RECOMENDADO):
DATABASE_URL=postgresql://postgres:CHANGE_ME_IN_PRODUCTION@db:5432/nap_crm
# Acesso direto pelo host local (somente se rodando sem container ou via porta publicada):
# DATABASE_URL=postgresql://postgres:CHANGE_ME_IN_PRODUCTION@127.0.0.1:5432/nap_crm

# --- 4. INTELIGÊNCIA ARTIFICIAL (GEMINI / MaIA) ---
GEMINI_API_KEY=CHANGE_ME_IN_PRODUCTION
GEMINI_MODEL=gemini-2.5-flash
# Configuração opcional via gateway/proxy de IA
GEMINI_BASE_URL=
GEMINI_USE_9ROUTER=false

# --- 5. MULTI-ERP (SGP / IXC / HUBSOFT) ---
ERP_URL=https://erp.provedor.com.br/api
ERP_APP=NAP_PROVEDOR_APP
ERP_TOKEN=CHANGE_ME_IN_PRODUCTION
SGP_URL=https://erp.provedor.com.br/api
SGP_APP=NAP_PROVEDOR_APP
SGP_TOKEN=CHANGE_ME_IN_PRODUCTION

# --- 6. TELEFONIA IP (ASTERISK 20+ NATIVO / ARI / AMI / SIP) ---
ASTERISK_HOST=127.0.0.1
ASTERISK_PORT_ARI=8088
ASTERISK_USER_ARI=nap_admin
ASTERISK_SECRET_ARI=CHANGE_ME_IN_PRODUCTION
ASTERISK_PORT_AMI=5038
ASTERISK_USER_AMI=nap_ami
ASTERISK_SECRET_AMI=CHANGE_ME_IN_PRODUCTION
ASTERISK_WEBSOCKET_URL=wss://127.0.0.1:8089/ws
ASTERISK_RAMAL_SECRET=CHANGE_ME_IN_PRODUCTION

# --- 7. TELEMETRIA CPE (GENIEACS TR-069 / CWMP) ---
GENIEACS_URL=http://127.0.0.1:7557
GENIEACS_CWMP_URL=http://127.0.0.1:7547
GENIEACS_PASSWORD=CHANGE_ME_IN_PRODUCTION
# Comunicação interna entre containers Docker (RECOMENDADO):
MONGODB_URI=mongodb://mongo:27017/genieacs
REDIS_URL=redis://redis:6379
# Acesso direto pelo host local:
# MONGODB_URI=mongodb://127.0.0.1:27017/genieacs
# REDIS_URL=redis://127.0.0.1:6379

# --- 8. WHATSAPP BUSINESS CLOUD API (META WABA) ---
WABA_PHONE_NUMBER_ID=CHANGE_ME_IN_PRODUCTION
WABA_BUSINESS_ACCOUNT_ID=CHANGE_ME_IN_PRODUCTION
WABA_VERIFY_TOKEN=CHANGE_ME_IN_PRODUCTION
WABA_ACCESS_TOKEN=CHANGE_ME_IN_PRODUCTION

# --- 9. GATEWAY FINANCEIRO PIX (BANCO C6 336 / ENLACE-PAY) ---
C6_CLIENT_ID=CHANGE_ME_IN_PRODUCTION
C6_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION
C6_CHAVE_PIX=CHANGE_ME_IN_PRODUCTION
C6_CERT_PATH=/opt/nap/certs/c6_client.crt
C6_KEY_PATH=/opt/nap/certs/c6_client.key
C6_WEBHOOK_URL=https://api.provedor.com.br/api/payments/webhook

# --- 10. NOC & MONITORAMENTO (ZABBIX 7.0 LTS) ---
# Contrato: Aceita URL base (http://127.0.0.1:8080/zabbix) ou completa com /api_jsonrpc.php
ZABBIX_URL=http://127.0.0.1:8080/zabbix
ZABBIX_TOKEN=CHANGE_ME_IN_PRODUCTION
ZABBIX_HOST_GROUP_ONUS=ONUs_GPON
ZABBIX_HOST_GROUP_OLTS=OLTs_Core

# --- 11. RADIUS (DISCONNECT / RE-AUTH PoD / CoA) ---
RADIUS_HOST=127.0.0.1
RADIUS_PORT=3799
RADIUS_SECRET=CHANGE_ME_IN_PRODUCTION

# --- 12. COMMUNICATIONS HUB & TELEGRAM ALERTS ---
TELEGRAM_BOT_TOKEN=CHANGE_ME_IN_PRODUCTION
TELEGRAM_NOC_CHAT_ID=CHANGE_ME_IN_PRODUCTION
