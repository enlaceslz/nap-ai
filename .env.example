# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ERP / SGP API Credentials (Nativo & Pré-configurado)
# Docs: https://bookstack.sgp.net.br/books/api/page/autenticacoes-via-api
ERP_URL="http://127.0.0.1:3000/api/mock-sgp"
ERP_APP="NAP_NATIVE_APP"
ERP_TOKEN="nap_native_sec_token_sgp"
SGP_URL="http://127.0.0.1:3000/api/mock-sgp"
SGP_APP="NAP_NATIVE_APP"
SGP_TOKEN="nap_native_sec_token_sgp"

# PostgreSQL Connection for NAP Backend
