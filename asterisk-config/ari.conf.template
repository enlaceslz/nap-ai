; ====================================================================
; NAP TELECOM - ARI CONFIGURATION TEMPLATE (Asterisk REST Interface)
; O script render-configs.sh gera as credenciais seguras em runtime.
; ====================================================================

[general]
enabled = yes
pretty = yes
allowed_origins = 127.0.0.1:3000,localhost:3000

[nap_admin]
type = user
read_only = no
password_format = plain
#tryinclude "ari_secret.conf"
#tryinclude "/etc/asterisk/ari_secret.conf"
