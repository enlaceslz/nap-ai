; ====================================================================
; NAP TELECOM - ASTERISK MANAGER INTERFACE TEMPLATE (MANAGER.CONF)
; O script render-configs.sh gera as credenciais seguras em runtime.
; ====================================================================

[general]
enabled = yes
port = 5038
bindaddr = 127.0.0.1
displayconnects = no

[nap_ami]
#tryinclude "manager_secret.conf"
#tryinclude "/etc/asterisk/manager_secret.conf"
deny = 0.0.0.0/0.0.0.0
permit = 127.0.0.1/255.255.255.255
read = system,call,log,verbose,command,agent,user,config
write = system,call,agent,user,config
